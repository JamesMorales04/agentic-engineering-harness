{
  "version": 1,
  "activeProfile": "balanced",
  "skillRoots": [".harness/skills", ".agents/skills", ".opencode/skills"],
  "runtimes": {
    "codex": { "adapter": "codex", "paseoProvider": "codex", "command": "codex", "capabilities": { "nativeAgent": false, "nativeAgentViaPaseo": false, "modelSelection": true, "variantSelection": true, "sessions": true, "mcp": true, "stdioMcp": true, "localMcp": true, "nativeToolProjection": true } },
    "opencode": { "adapter": "opencode", "paseoProvider": "opencode", "command": "opencode", "capabilities": { "nativeAgent": true, "nativeAgentViaPaseo": false, "modelSelection": true, "variantSelection": true, "sessions": true, "structuredOutput": true, "mcp": true, "stdioMcp": true, "localMcp": true, "runtimeConfigInjection": true, "nativeToolProjection": true } }
  },
  "models": {
    "brain": { "runtime": "codex", "provider": "openai", "model": "gpt-6-luna", "variant": "xhigh" },
    "workhorse": { "runtime": "opencode", "provider": "opencode-go", "model": "MiMo-V2.6-Flash" }
  },
  "agents": {
    "lead": { "role": "Lead/Director", "domains": ["*"], "description": "Own intent, decomposition, risk decisions and final semantic acceptance. Delegate bounded repository work and preserve sealed requirements.", "execution": { "model": "@brain" }, "contextRequirements": { "repositoryMap": "FORBIDDEN", "semanticRetrieval": "FORBIDDEN", "rawRetrieval": "FORBIDDEN" }, "skills": ["engineering-workflow", "lead-engineer", "verification-planning", "worktree-lifecycle"], "permissions": { "read": "allow", "write": "deny", "shell": "allow", "network": "ask", "delegate": "allow", "review": "allow", "validate": "deny", "gitWrite": "deny" }, "outputContract": "orchestrator" },
    "operation-supervisor": { "role": "Operation Supervisor", "domains": ["*"], "description": "Own operation-local coordination, delegation, consolidation and evidence gaps for one durable operation.", "execution": { "model": "@brain" }, "contextRequirements": { "repositoryMap": "FORBIDDEN", "semanticRetrieval": "FORBIDDEN", "rawRetrieval": "FORBIDDEN", "compression": "OPTIONAL" }, "skills": [], "permissions": { "read": "allow", "write": "deny", "shell": "allow", "network": "deny", "delegate": "allow", "review": "allow", "validate": "deny", "gitWrite": "deny" }, "outputContract": "supervisor" },
    "explorer": { "role": "Explorer", "domains": ["*"], "description": "Perform bounded repository discovery and return evidence, paths, symbols and risks without editing.", "execution": { "model": "@workhorse" }, "permissions": { "read": "allow", "write": "deny", "shell": "allow", "network": "deny", "delegate": "deny", "review": "deny", "validate": "deny", "gitWrite": "deny" }, "outputContract": "explorer" },
    "librarian": { "role": "Librarian", "domains": ["*"], "description": "Research authoritative documentation and project-local knowledge after a deterministic knowledge gap; do not edit.", "execution": { "model": "@workhorse" }, "mcps": ["context7"], "permissions": { "read": "allow", "write": "deny", "shell": "deny", "network": "allow", "delegate": "deny", "review": "deny", "validate": "deny", "gitWrite": "deny" }, "outputContract": "knowledge-pack" },
    "planner": { "role": "Planner", "domains": ["*"], "description": "Produce dependency-aware bounded work units from frozen requirements, evidence and validation gates; never select agents by name.", "execution": { "model": "@brain" }, "skills": ["routing-normalizer", "verification-planning", "acceptance-traceability"], "permissions": { "read": "allow", "write": "deny", "shell": "allow", "network": "deny", "delegate": "allow", "review": "allow", "validate": "deny", "gitWrite": "deny" }, "outputContract": "planner" },
    "spec-manager": { "role": "Spec Manager", "domains": ["requirements", "specification", "sdd", "openspec"], "description": "Author and validate formal requirements before freeze; deterministic AEH code compiles and seals them.", "execution": { "model": "@brain" }, "skills": ["openspec-authoring", "acceptance-traceability", "verification-planning"], "permissions": { "read": "allow", "write": "allow", "shell": "allow", "network": "deny", "delegate": "allow", "review": "deny", "validate": "deny", "gitWrite": "deny" }, "outputContract": "spec-authoring" },
    "implementer": { "role": "Implementer", "domains": ["*"], "specializations": ["cross-cutting"], "description": "Implement only frozen, task-scoped changes and return reproducible evidence. Technology belongs in task domains and competencies.", "execution": { "model": "@workhorse" }, "skills": ["implementation-worker", "verification-planning"], "permissions": { "read": "allow", "write": "allow", "shell": "allow", "network": "ask", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "reviewer": { "role": "Reviewer", "domains": ["*"], "specializations": ["cross-cutting"], "description": "Independently assess scope, correctness, security and evidence without changing the candidate.", "execution": { "model": "@workhorse" }, "skills": ["finding-dedup", "simplify", "acceptance-traceability"], "permissions": { "read": "allow", "write": "deny", "shell": "allow", "network": "deny", "review": "allow", "gitWrite": "deny" }, "outputContract": "reviewer" },
    "repairer": { "role": "Repairer", "domains": ["*"], "specializations": ["cross-cutting"], "description": "Apply bounded repairs to failed candidates while preserving frozen scope and independent re-validation.", "execution": { "model": "@brain" }, "skills": ["verification-planning", "simplify", "recovery-classifier"], "permissions": { "read": "allow", "write": "allow", "shell": "allow", "network": "ask", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "semantic-assessor": { "role": "Semantic Assessor", "domains": ["*"], "description": "Return one bounded typed semantic judgment from controller-supplied evidence. This agent has no repository or tool access and has no authority.", "execution": { "model": "@workhorse", "transport": "paseo" }, "skills": [], "mcps": [], "contextRequirements": { "repositoryMap": "FORBIDDEN", "semanticRetrieval": "FORBIDDEN", "rawRetrieval": "FORBIDDEN", "compression": "FORBIDDEN" }, "permissions": { "read": "deny", "write": "deny", "shell": "deny", "network": "deny", "delegate": "deny", "review": "deny", "validate": "deny", "gitWrite": "deny" }, "outputContract": "semantic-assessment" }
  },
  "profiles": {
    "economy": { "description": "Use the workhorse for bounded participants and the brain for planning, control and repair.", "agents": { "lead": { "execution": { "model": "@brain" } }, "planner": { "execution": { "model": "@brain" } }, "repairer": { "execution": { "model": "@brain" } } } },
    "balanced": { "description": "Use canonical roles with domain selection and deterministic validation.", "agents": { "reviewer": { "execution": { "model": "@workhorse" } } } },
    "maximum-quality": { "description": "Use the brain for planning, review and repair.", "agents": { "planner": { "execution": { "model": "@brain" } }, "reviewer": { "execution": { "model": "@brain" } }, "repairer": { "execution": { "model": "@brain" } } } }
  },
  "routing": [
    { "id": "operation-supervision", "priority": 120, "when": { "intent": ["operation-supervision"] }, "select": { "role": "Operation Supervisor" } },
    { "id": "spec-authoring", "priority": 100, "when": { "intent": ["spec-authoring", "openspec"] }, "select": { "role": "Spec Manager" } },
    { "id": "high-risk-review", "priority": 35, "when": { "intent": "implement", "risk": "high" }, "review": [{ "role": "Reviewer", "domains": ["*"] }] },
    { "id": "default-implementation", "priority": 0, "when": { "intent": "implement" }, "select": { "role": "Implementer" }, "review": [{ "role": "Reviewer", "domains": ["*"] }] }
  ],
  "recovery": {
    "PATCH_CONTEXT_MISMATCH": [{ "action": "same-agent" }, { "action": "reroute" }, { "action": "lead" }],
    "TOOL_FAILURE": [{ "action": "same-agent" }, { "action": "reroute" }, { "action": "lead" }],
    "MISSING_CONTEXT": [{ "action": "same-agent" }, { "action": "lead" }],
    "WRONG_AGENT": [{ "action": "reroute" }, { "action": "lead" }],
    "VALIDATION_FAILURE": [{ "action": "same-agent" }, { "action": "reroute" }, { "action": "lead" }],
    "REVIEW_FAILURE": [{ "action": "reroute" }, { "action": "lead" }],
    "AMBIGUOUS_OUTPUT": [{ "action": "same-agent" }, { "action": "lead" }],
    "CONFLICTING_RESULTS": [{ "action": "reroute" }, { "action": "lead" }]
  }
}
