{
  "version": 1,
  "extends": ["aeh:default"],
  "runtimes": { "opencode": { "capabilities": { "nativeAgentViaPaseo": true } } },
  "models": { "workhorse": { "runtime": "opencode", "provider": "opencode-go", "model": "MiMo-V2.6-Flash", "variant": "max" } },
  "agents": {
    "lead": { "temperature": 0.1, "skills": ["engineering-workflow", "lead-engineer", "paseo-orchestration", "verification-planning", "worktree-lifecycle"] },
    "operation-supervisor": { "temperature": 0.1 },
    "planner": { "temperature": 0.05, "permissions": { "shell": "deny" } },
    "implementer": { "temperature": 0.1 },
    "reviewer": { "temperature": 0.1 },
    "repairer": { "temperature": 0.1 },
    "spec-manager": { "temperature": 0.1 }
  },
  "routing": []
}
