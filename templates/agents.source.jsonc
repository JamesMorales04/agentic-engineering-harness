{
  "version": 1,
  "extends": ["aeh:orchestration"],
  "activeProfile": "balanced",

  // Override a built-in model alias once and every agent using it follows.
  // "models": {
  //   "workhorse": { "provider": "opencode-go", "model": "deepseek-v4-flash" },
  //   "brain": { "provider": "openai", "model": "gpt-5.6-luna", "variant": "max" }
  // },
  "models": {},

  // Add a new agent or partially override a built-in agent by name.
  // "agents": {
  //   "backend-implementer": { "temperature": 0.05 },
  //   "domain-specialist": {
  //     "role": "implementer",
  //     "domains": ["my-domain"],
  //     "execution": { "model": "@workhorse" },
  //     "permissions": { "read": "allow", "write": "allow", "shell": "allow" },
  //     "outputContract": "implementer"
  //   }
  // },
  "agents": {},

  // Rules with an existing id replace the built-in rule; new ids are appended.
  "routing": [],

  // Removal supports minimatch patterns and cascades agent references out of routing/recovery/councils.
  // Example: remove every mobile agent from a non-mobile repository.
  "remove": {
    "agents": [],
    "models": [],
    "runtimes": [],
    "profiles": [],
    "routing": [],
    "councils": []
  }
}
