{
  "version": 1,
  "activeProfile": "balanced",
  "skillRoots": [".harness/skills", ".opencode/skills"],
  "runtimes": {
    "codex": { "adapter": "codex", "paseoProvider": "codex", "command": "codex", "capabilities": { "nativeAgent": false, "nativeAgentViaPaseo": false, "modelSelection": true, "variantSelection": true, "sessions": true } },
    "opencode": { "adapter": "opencode", "paseoProvider": "opencode", "command": "opencode", "capabilities": { "nativeAgent": true, "nativeAgentViaPaseo": false, "modelSelection": true, "variantSelection": true, "sessions": true, "structuredOutput": true } }
  },
  "models": {
    "brain": { "runtime": "codex", "provider": "openai", "model": "gpt-5.6-luna", "variant": "max" },
    "workhorse": { "runtime": "opencode", "provider": "opencode-go", "model": "deepseek-v4-flash" }
  },
  "agents": {
    "lead": { "role": "orchestrator", "execution": { "model": "@brain" }, "skills": ["engineering-workflow", "lead-engineer"], "permissions": { "read": "allow", "write": "deny", "delegate": "allow", "review": "allow", "validate": "deny" }, "outputContract": "orchestrator" },
    "planner": { "role": "planner", "execution": { "model": "@brain" }, "permissions": { "read": "allow", "write": "deny", "delegate": "allow", "validate": "deny" }, "outputContract": "planner" },
    "implementation-worker": { "role": "implementer", "domains": ["*"], "execution": { "model": "@workhorse" }, "permissions": { "read": "allow", "write": "allow", "shell": "allow", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "quality-implementer": { "role": "implementer", "domains": ["quality-remediation"], "description": "Focused remediation worker used after quality stagnation.", "execution": { "model": "@workhorse" }, "permissions": { "read": "allow", "write": "allow", "shell": "allow", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "senior-implementer": { "role": "implementer", "domains": ["quality-remediation", "complex-remediation"], "description": "Stronger remediation worker for persistent or cycling quality debt.", "execution": { "model": "@brain" }, "permissions": { "read": "allow", "write": "allow", "shell": "allow", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "oracle": { "role": "escalation", "domains": ["diagnosis"], "description": "Independent root-cause and exception classifier. It does not modify files.", "execution": { "model": "@brain" }, "permissions": { "read": "allow", "write": "deny", "review": "allow", "delegate": "deny" }, "outputContract": "recovery" },
    // Native OpenCode agents are guaranteed with direct/podman transport because OpenCode exposes `run --agent`.
    "native-opencode-worker": { "role": "implementer", "domains": ["native-opencode"], "execution": { "model": "@workhorse", "transport": "direct", "nativeAgent": "build" }, "permissions": { "read": "allow", "write": "allow", "shell": "allow", "delegate": "deny", "gitWrite": "deny" }, "outputContract": "implementer" },
    "architecture-reviewer": { "role": "reviewer", "domains": ["architecture"], "execution": { "model": "@brain" }, "permissions": { "read": "allow", "write": "deny", "review": "allow" }, "outputContract": "reviewer" },
    "validator": { "role": "validator", "execution": { "model": "@workhorse" }, "permissions": { "read": "allow", "write": "deny", "shell": "allow", "validate": "allow" }, "outputContract": "validator" }
  },
  "profiles": {
    "economy": { "agents": { "*": { "execution": { "model": "@workhorse" } }, "lead": { "execution": { "model": "@brain" } }, "senior-implementer": { "execution": { "model": "@brain" } }, "oracle": { "execution": { "model": "@brain" } } } },
    "balanced": { "agents": { "*-reviewer": { "execution": { "model": "@workhorse" } }, "architecture-reviewer": { "execution": { "model": "@brain" } }, "planner": { "execution": { "model": "@brain" } }, "senior-implementer": { "execution": { "model": "@brain" } }, "oracle": { "execution": { "model": "@brain" } }, "lead": { "execution": { "model": "@brain" } } } },
    "maximum-quality": { "agents": { "*-reviewer": { "execution": { "model": "@brain" } }, "quality-implementer": { "execution": { "model": "@brain" } }, "senior-implementer": { "execution": { "model": "@brain" } }, "oracle": { "execution": { "model": "@brain" } }, "planner": { "execution": { "model": "@brain" } }, "lead": { "execution": { "model": "@brain" } } } }
  },
  "routing": [
    { "id": "native-opencode", "priority": 20, "when": { "intent": "implement", "domains": ["native-opencode"] }, "use": "native-opencode-worker", "validators": ["validator"] },
    { "id": "default-implementation", "priority": 0, "when": { "intent": "implement" }, "use": "implementation-worker", "reviewers": ["architecture-reviewer"], "validators": ["validator"] }
  ],
  "recovery": {
    "PATCH_CONTEXT_MISMATCH": [{ "action": "same-agent" }, { "action": "lead" }], "TOOL_FAILURE": [{ "action": "same-agent" }, { "action": "lead" }], "MISSING_CONTEXT": [{ "action": "same-agent" }, { "action": "lead" }], "WRONG_AGENT": [{ "action": "reroute" }, { "action": "lead" }], "VALIDATION_FAILURE": [{ "action": "same-agent" }, { "action": "lead" }], "REVIEW_FAILURE": [{ "action": "same-agent" }, { "action": "lead" }], "AMBIGUOUS_OUTPUT": [{ "action": "same-agent" }, { "action": "lead" }], "CONFLICTING_RESULTS": [{ "action": "lead" }]
  }
}
