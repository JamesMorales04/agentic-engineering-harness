{
  "version": 1,
  "extends": ["aeh:orchestration"],
  "activeProfile": "balanced",

  // Override a built-in model alias once and every agent using it follows.
  // "models": {
  //   "workhorse": { "provider": "opencode-go", "model": "MiMo-V2.6-Flash", "variant": "max" },
  //   "brain": { "provider": "openai", "model": "gpt-6-luna", "variant": "xhigh" }
  // },
  "models": {},

  // Add a canonical participant runtime profile or override a built-in role.
  // "agents": {
  //   "implementer": { "temperature": 0.05 },
  //   "implementer": {
  //     "role": "Implementer",
  //     "domains": ["my-domain"],
  //     "specializations": ["my-specialization"],
  //     "execution": { "model": "@workhorse" },
  //     "permissions": { "read": "allow", "write": "allow", "shell": "allow" },
  //     "outputContract": "implementer"
  //   }
  // },
  "agents": {},

  // Rules select canonical roles and their domains; runtime identity is resolved after selection.
  "routing": [],

  // Removal supports minimatch patterns and cascades agent references out of routing/recovery/councils.
  // Example: remove every mobile agent from a non-mobile repository.
  "remove": {
    "agents": [],
    "models": [],
    "runtimes": [],
    "profiles": [],
    "routing": [],
    "councils": []
  }
}
