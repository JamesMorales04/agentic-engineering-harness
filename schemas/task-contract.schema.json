{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Engineering Harness TaskContract",
  "type": "object",
  "required": ["version", "task"],
  "properties": {
    "version": { "const": 1 },
    "task": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string" }, "title": { "type": "string" } } },
    "source": { "type": "object" }, "git": { "type": "object" }, "scope": { "type": "object" },
    "routing": { "type": "object", "properties": { "intent": { "type": "string" }, "domains": { "type": "array", "items": { "type": "string" } }, "risk": { "enum": ["low", "medium", "high"] }, "agent": { "type": "string" }, "reviewers": { "type": "array", "items": { "type": "string" } }, "profile": { "type": "string" } } },
    "requirements": { "type": "array" }, "constraints": { "type": "object" }, "impact": { "type": "object" }, "repair": { "type": "object" }, "verification": { "type": "object" }
  }
}
