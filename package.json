{
  "name": "agentic-engineering-harness",
  "version": "0.6.28",
  "description": "OSS-first engineering harness for deterministic, spec-driven, issue-driven, audit-governed and orchestration-first multi-agent software delivery.",
  "type": "module",
  "bin": {
    "engineering-harness": "./dist/main.js",
    "aeh": "./dist/main.js"
  },
  "files": [
    "dist",
    "templates",
    "presets",
    "policies",
    "schemas",
    "skills",
    "docs",
    "scripts/link-self-bin.mjs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build && node scripts/link-self-bin.mjs",
    "aeh": "node ./dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "release:check": "npm run check && npm pack --dry-run",
    "release:resolve": "node scripts/release-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "commander": "^14.0.1",
    "minimatch": "^10.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "agentic-engineering-harness": "^0.6.27",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesMorales04/agentic-engineering-harness.git"
  },
  "homepage": "https://github.com/JamesMorales04/agentic-engineering-harness#readme",
  "bugs": {
    "url": "https://github.com/JamesMorales04/agentic-engineering-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ai-agents",
    "codex",
    "opencode",
    "paseo",
    "openspec",
    "sdd",
    "audit",
    "code-review",
    "github-issues",
    "issue-driven-development",
    "quick-contract",
    "gherkin",
    "agent-routing",
    "agent-presets",
    "orchestration",
    "context-handoff",
    "mcp",
    "github-delivery",
    "worktrees",
    "multi-model",
    "multi-worker",
    "distributed-workers",
    "quality-convergence",
    "evidence-graph",
    "policy-bundles",
    "sandbox",
    "toolchain",
    "mise",
    "bootstrap",
    "human-on-exception",
    "deterministic-validation",
    "engineering-harness",
    "slsa",
    "opentelemetry"
  ]
}
