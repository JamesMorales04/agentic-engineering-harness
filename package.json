{
  "name": "agentic-engineering-harness",
  "version": "0.4.8",
  "description": "OSS-first engineering harness for deterministic, spec-driven multi-agent software delivery.",
  "type": "module",
  "bin": { "engineering-harness": "./dist/cli.js", "aeh": "./dist/cli.js" },
  "files": ["dist", "templates", "presets", "policies", "schemas", "skills", "docs"],
  "scripts": { "build": "tsc -p tsconfig.json", "dev": "tsx src/cli.ts", "test": "vitest run", "test:watch": "vitest", "typecheck": "tsc -p tsconfig.json --noEmit", "check": "npm run typecheck && npm test && npm run build", "release:check": "npm run check && npm pack --dry-run" },
  "engines": { "node": ">=22" },
  "dependencies": { "@opentelemetry/api": "^1.9.0", "commander": "^14.0.1", "minimatch": "^10.0.3", "yaml": "^2.8.1", "zod": "^4.0.17" },
  "devDependencies": { "@types/node": "^24.2.1", "tsx": "^4.20.3", "typescript": "^5.9.2", "vitest": "^3.2.4" },
  "license": "Apache-2.0",
  "keywords": ["ai-agents", "codex", "opencode", "paseo", "sdd", "gherkin", "agent-routing", "multi-model", "deterministic-validation", "engineering-harness", "slsa", "opentelemetry"]
